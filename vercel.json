{
  "buildCommand": "npm install && cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "SMTP_HOST": "mail.infomaniak.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false"
  },
  "crons": [
    {
      "path": "/api/cron/action-reminders",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
