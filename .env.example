# Base interne de l'application
DATABASE_URL=postgresql://utilisateur:mot_de_passe@serveur:5432/suivi_impaye

# Acces OpenPROD fourni par Kazacube (lecture seule)
ERP_DB_HOST=
ERP_DB_PORT=5432
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_POOL_MAX=5
ERP_DB_CONNECT_TIMEOUT_MS=10000
ERP_SYNC_TARGET_URL=https://suivi-impaye.vercel.app/api/erp-sync
ERP_SYNC_SECRET=
# Correspondances supplementaires optionnelles, ex. 81:ALI,82:SARA
ERP_COMMERCIAL_MAP=
# Tables autorisees : res_partner, account_invoice, account_invoice_line,
# account_voucher, account_voucher_line

# Securite de l'application
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5173

# Notifications e-mail Gadimat
SMTP_HOST=secure.emailsrvr.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hatim.lakrouni@gadimat.com
# Secret obligatoire : a definir localement et dans Vercel, jamais dans Git
SMTP_PASS=
SMTP_FROM_EMAIL=hatim.lakrouni@gadimat.com
SMTP_FROM_NAME=GADIMAT - Suivi des impayés
